# --- 1. Identity & Editor ---
set realname = "Marco"
set editor   = "nvim"

# --- 2. Paths & Mailboxes ---
set folder       = "~/.mail"
set mbox_type    = Maildir
set spoolfile    = "+studio/INBOX"
set mailcap_path = "~/.config/neomutt/mailcap"

# Match these to your mbsync 'Path' settings
mailboxes -label "Studio" "+studio/INBOX" "+studio/Sent"
mailboxes -label "Mail"  "+mail/INBOX" "+mail/Sent"
mailboxes -label "Inkorg" "+Inkorg/INBOX" "+Inkorg/Sent"
mailboxes -label "Yahoo"  "+yahoo/INBOX"  "+yahoo/Sent"

# --- 3. Sidebar Configuration ---
set sidebar_visible       = yes
set sidebar_width         = 25
set sidebar_short_path    = yes
set sidebar_folder_indent = yes
set sidebar_format        = "%B%* [%N]"
set sidebar_delim_chars   = "/"
set sidebar_indent_string = "  "

# Sidebar Navigation
bind index,pager \t         sidebar-next
bind index,pager <BackTab>  sidebar-prev
bind index,pager \Cn        sidebar-next
bind index,pager \Cp        sidebar-prev
bind index,pager \Co        sidebar-open
bind index,pager b          sidebar-toggle-visible

# --- 4. Navigation (Vim Keys) ---
bind index,attach j next-entry
bind index,attach k previous-entry
bind pager j next-line
bind pager k previous-line
bind pager J next-entry
bind pager K previous-entry
bind generic j next-entry
bind generic k previous-entry

# --- The Universal "Cancel/Back" Key ---
# Use 'ö' to exit menus (like the 'To:' or 'Compose' menu)
bind index,pager,attach,compose ö exit

# Use 'ö' to cancel a prompt in the editor (the bottom line)
# For the Editor (To, Subject prompts), simulate a Ctrl-g
bind editor ö noop
macro editor ö "<obfuscate-key-sequence>^g"

# Generic safety catch-all
bind generic ö exit

# Mark all unread messages in the current folder as read
macro index L "<tag-pattern>~U<enter><tag-prefix><clear-flag>N<untag-pattern>.<enter>" "Mark all messages as read"

# Define where your Trash is (adjust the path to match your setup)
set trash = "+Trash"

# Automatically move 'deleted' messages to the Trash folder
# instead of just marking them for purging.
bind index d delete-message
# Bind 'u' to undelete (the default, but good to keep track of)
bind index u undelete-message

# --- 5. HTML Handling & Link Extraction ---
alternative_order text/html text/plain
auto_view text/html text/calendar application/ics

# Fixed U macro: Using single quotes on the outside to keep italics working
macro pager U "<pipe-message>urlview<enter>"  #"View Links with urlview"

# L: Clean Interactive w3m
macro pager L "<enter-command>set pipe_decode=yes<enter><pipe-entry>w3m -T text/html -I %{charset} -config ~/.config/w3m/mutt_config<enter><enter-command>set pipe_decode=no<enter>" # "Interactive w3m (Clean & Fast)"

# --- 6. Sync & Address Book ---

# 'S' runs mbsync for all accounts
macro index S "<shell-escape>mbsync -a<enter><check-stats>" "Sync all mail"

set query_command = "abook --mutt-query '%s'"
macro index,pager A "<pipe-message>abook --add-email<enter>" "Add to abook"
bind editor <Tab> complete-query

# --- 7. Sorting & Performance ---
set sort        = threads
set sort_aux    = reverse-last-date-received
set menu_scroll = yes
set timeout     = 10


# --- 8. Account Hooks & Dynamic Colors ---

# Studio - Cyan (color37)
folder-hook "studio/*" "source ~/.config/neomutt/accounts/studio; color status color115 default"

# Combi - Magenta (color162)
folder-hook "mail_combi/*" "source ~/.config/neomutt/accounts/combi; color status color133 default"

# Inkorg - Yellow (color136)
folder-hook "Inkorg/*" "source ~/.config/neomutt/accounts/inkorg; color status color222 default"

# Yahoo - Purple (color134)
folder-hook "yahoo/*" "source ~/.config/neomutt/accounts/yahoo; color status color183 default"

# Sent Folder Color (Complementary)
# This will highlight Sent messages in the index with the colors we picked earlier
color index color166 default "~f studio/Sent"
color index color33  default "~f Inkorg/Sent"
color index color106 default "~f mail_combi/Sent"
color index color64  default "~f yahoo/Sent"

# --- 9. Theming ---
source /usr/share/neomutt/colorschemes/solarized-dark-256.neomuttrc

color index          brightyellow  default  "~U"
color index          brightcyan    default  "~N"

# These apply to folders with NEW mail:
# Note: NeoMutt colors the WHOLE line based on status, 
# not specific folders by name.
color sidebar_new    color37   default  # Studio-ish Cyan
color sidebar_flagged color136  default  # Inkorg-ish Gold
color sidebar_divider color240  default  # Subtle grey divider

color sidebar_highlight black      white
color sidebar_indicator brightmagenta default

# --- 10. Account Switching Macros ---
macro index 1 "<change-folder>+studio/INBOX<enter>" "Go to Studio"
macro index 2 "<change-folder>+mail_combi/INBOX<enter>" "Go to Combi"
macro index 3 "<change-folder>+Inkorg/INBOX<enter>" "Go to Inkorg"
macro index 4 "<change-folder>+yahoo/INBOX<enter>" "Go to Yahoo"
